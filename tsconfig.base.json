{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // El agente ejecuta TypeScript directamente con el despojado de tipos de Node, que
    // resuelve las rutas literalmente. Por eso los imports internos llevan .ts real.
    "allowImportingTsExtensions": true
  }
}
