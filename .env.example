# Copia este archivo como .env.local y rellena los valores reales.
# Nunca comitees .env.local ni ningún archivo con credenciales reales.

# ─── Portal (capa realtime) ───────────────────────────────────────────────────
# Publishable key (pk_…): segura en el bundle del navegador.
VITE_PORTAL_API_KEY=
# La misma key para el agente (proceso Node).
PORTAL_API_KEY=

# Secret key del proyecto (sk_…). SOLO para el CLI de Portal (`portal deploy`,
# `portal secrets set`). Nunca en el frontend ni en el agente.
PORTAL_SECRET=

# Secreto compartido agente ↔ middleware de Portal: firma los mensajes de la IA
# para que ningún navegador pueda suplantarla. Regístralo también como secret de
# Portal (lo lee portal.config.ts vía env("AGENT_SECRET")).
AGENT_SECRET=

# ─── OpenRouter (inferencia de la IA) ─────────────────────────────────────────
# Solo la usa el agente. Jamás en el frontend.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
OPENROUTER_MODEL_FALLBACK=google/gemini-2.5-flash
