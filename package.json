{
  "name": "el-paciente",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @el-paciente/web dev",
    "build": "pnpm --filter @el-paciente/web build",
    "preview": "pnpm --filter @el-paciente/web preview",
    "agent": "pnpm --filter @el-paciente/agent start",
    "extras": "pnpm --filter @el-paciente/agent extras",
    "portal:deploy": "portal deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p apps/web/tsconfig.json && tsc -p apps/agent/tsconfig.json && tsc -p tsconfig.portal.json"
  },
  "devDependencies": {
    "@el-paciente/shared": "workspace:*",
    "@portalsdk/cli": "^0.5.5",
    "@portalsdk/config": "^0.2.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
